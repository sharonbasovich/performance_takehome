  "statistics": {
    "bootstrap_resamples": 2000,
    "confidence": 0.95,
    "min_requests_per_cell": 30,
    "min_effect": {
      "ttft_p50_rel": 0.1,
      "ttft_p90_rel": 0.15,
      "fluidity_index_abs": 0.05,
      "ftgr_rel": 0.1,
      "startup_rel": 0.2
    },
    "decision": "two-sided bootstrap percentile CI of the paired-cell difference; regression only if the CI excludes zero AND the point estimate exceeds min_effect; inconclusive if the CI straddles the min_effect boundary; family-wise correction = Bonferroni across compared cells per metric"
  },
  "design_revision": {
    "pruned_redundancy": [
      "Calibration is captured once in a separate mode and never refitted from scored data.",
      "All four original scored chat rates are retained: A/A controls do not substitute for a cross-run comparison load point.",
      "No-flush default has zero explicit cache-flush delay. Request-specific leading nonces reduce shared user-prefix reuse; common chat-template state is not flushed."
    ],
    "statistics": "Three repetitions and the sample floor are starting policies, not proof of power. Use pilot noise/CI widths to freeze sufficient counts before comparisons; retain inconclusive results when evidence is weak.",
