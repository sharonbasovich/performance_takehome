{
  "schema_version": "1.0.0",
  "plan_id": "abstract-t1-llmd-mi355x-efficient-v2",
  "status": "CANDIDATE-DEFINED; unmeasured pilot-ready design, requires separate baseline calibration",
  "target": {
    "engine_lock": "baseline/lock.json",
    "model_role": "target",
    "base_url": "http://127.0.0.1:8000",
    "endpoint": "/v1/chat/completions",
    "readiness_endpoint": "/v1/models"
  },
  "seeds": {
    "prompt_seed": 20260101,
    "arrival_seed": 20260102,
    "bootstrap_seed": 20260103
  },
  "output_policy": {
    "temperature": 0,
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "stop": null
  },
  "deadlines": {
    "prefill": {
      "model": "intercept_plus_slope",
      "intercept_s": 0.25,
      "slope_s_per_prompt_token": 0.0005,
      "floor_s": 0.3,
      "scheduling_slack_s": 0.05,
      "note": "Etalon 4.1: D_p is a function of prompt length and should be re-fit from the prefill_calibration cell on the pilot; constants here are placeholders, not measurements."
    },
    "decode_tiers": {
      "strict": {
        "deadline_s": 0.025,
        "rationale": "Etalon 5 uses a 25 ms TBT SLO as the strict tier (40 tok/s)."
      },
      "medium": {
        "deadline_s": 0.05,
        "rationale": "20 tok/s: comfortable interactive reading plus headroom."
      },
      "relaxed": {
        "deadline_s": 0.1667,
        "rationale": "Etalon 2.2: 250 words/min ~ 6 tok/s is the reading-speed floor."
      }
    },
    "fluidity_slo": {
      "max_miss_rate": 0.1,
      "request_quantile": 0.99,
      "min_index": 0.9
    },
    "ttft_slo_s": {
      "chat": 1,
      "rag": 4,
      "generation": 1
    }
  },
  "token_accounting": {
    "method": "verified pinned output tokenizer for real captures; task-local regex only for mock output and approximate prompt lengths",
    "server_usage_trusted": false,
    "usage_ratio_band": [
      0.5,
      2
    ],
    "note": "Counts re-encode completed output, not hidden engine IDs. Prompt length remains an approximate covariate. Do not tighten the usage band until parity is measured."
  },
  "client_integrity": {
    "max_event_loop_lag_s": 0.05,
    "max_send_lag_s": 0.25,
    "note": "Runs whose client lagged more than this during the measurement phase are invalid: the client, not the server, would own the timing."
  },
  "startup": {
    "procedure": [
      "cold start the pinned engine container (clock starts at launch)",
      "poll readiness_endpoint every 1 s; record each probe; readiness never stops the clock",
      "issue probe generations every 2 s; the first one that is a VALID completed generation stops the clock"
    ],
    "readiness_poll_interval_s": 1,
    "probe_interval_s": 2,
    "max_wait_s": 1200,
    "probe_prompt_source": "chat_short",
    "probe_max_tokens": 32,
    "planning_cold_start_s": 480,
    "note": "planning_cold_start_s is a pilot placeholder (27B weights into HBM plus LLMD compile); it is replaced by measured launches."
  },
  "warmup": {
    "requests_per_cell": 4,
    "phase": "warmup",
    "scored": false,
    "note": "Excluded from every statistic; recorded with phase=warmup so the population table still accounts for them."
  },
  "cache_state": {
    "request": "unique_leading_nonce_v1",
    "fallback_if_unsupported": "A deterministic request-specific leading user-content nonce prevents identical user prefixes. Shared chat-template state and coincidental short token prefixes remain unflushed; engine block-cache behavior is not asserted.",
    "shared_prefix_cells": []
  },
